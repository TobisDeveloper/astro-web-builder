{
  "name": "astro-web-builder",
  "version": "0.2.0",
  "description": "Forma — a visual Astro website builder with a designer canvas, custom fonts and brand kits.",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "test": "playwright test",
    "test:install": "playwright install chromium",
    "desktop:install": "node desktop/tools.cjs install",
    "desktop": "npm run build && node desktop/tools.cjs start",
    "desktop:pack": "npm run build && node desktop/tools.cjs pack --dir --publish never",
    "desktop:win": "npm run build && node desktop/tools.cjs pack --win --x64 --publish never",
    "test:desktop": "node desktop/smoke.cjs",
    "desktop:doctor": "node desktop/tools.cjs doctor",
    "test:desktop-tools": "node --test desktop/tools.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TobisDeveloper/astro-web-builder.git"
  },
  "keywords": [],
  "author": "TobisDeveloper",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/TobisDeveloper/astro-web-builder/issues"
  },
  "homepage": "https://github.com/TobisDeveloper/astro-web-builder#readme",
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "astro": "^7.4.2",
    "fflate": "^0.8.3",
    "gsap": "^3.13.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
